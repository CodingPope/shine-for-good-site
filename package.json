{
  "name": "shine-for-good",
  "version": "0.1.0",
  "description": "Shine for Good — cleaning with purpose, St. Pete & Tampa Bay",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--no-deprecation next dev",
    "build": "printf 'n\\n' | NODE_OPTIONS='--no-deprecation --max-old-space-size=8000' payload migrate && payload generate:types && next build",
    "postinstall": "NODE_OPTIONS=--no-deprecation payload generate:importmap || true",
    "start": "NODE_OPTIONS=--no-deprecation next start",
    "payload": "NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "NODE_OPTIONS=--no-deprecation payload generate:types",
    "db:migrate": "NODE_OPTIONS=--no-deprecation payload migrate"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.84.1",
    "@payloadcms/email-resend": "^3.87.1",
    "@payloadcms/live-preview-react": "^3.87.1",
    "@payloadcms/next": "^3.84.1",
    "@payloadcms/richtext-lexical": "^3.84.1",
    "@payloadcms/storage-vercel-blob": "^3.84.1",
    "@payloadcms/ui": "^3.84.1",
    "graphql": "^16.8.1",
    "next": "15.3.9",
    "payload": "^3.84.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.32.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.3.9",
    "typescript": "^5.8.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "sharp@0.32.6": true,
    "fsevents@2.3.3": true
  }
}
