# Database (Neon or Vercel Postgres)
DATABASE_URL=postgresql://user:password@host/dbname

# Payload secret (generate with: openssl rand -hex 32)
PAYLOAD_SECRET=your-secret-here

# Vercel Blob (for image uploads)
BLOB_READ_WRITE_TOKEN=

# Resend (transactional email — lead notifications, follow-ups)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Shine for Good

# Email address that gets notified about new/stale leads
OWNER_NOTIFICATION_EMAIL=cmsawyer12@gmail.com

# Shared secret so only Vercel Cron can trigger the lead follow-up job
CRON_SECRET=

# App URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
